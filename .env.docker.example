# ─── LogicBridge Docker Compose Local Configuration ──────────────────────────
# Copy to .env in repository root to override defaults:
# cp .env.docker.example .env

# Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=super_secure_local_dev_jwt_secret_min_32_characters
CREDENTIAL_ENCRYPTION_KEY=super_secure_local_dev_key_min_32_characters
OAUTH_STATE_SECRET=super_secure_local_dev_oauth_secret_min_32_characters

# AI Provider Keys (Optional for local testing)
GEMINI_API_KEY=
ALLOW_PRIVATE_AI_ENDPOINTS=false
ALLOW_OLLAMA_LOCAL=false

# Google OAuth Integration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback

# Ports
FRONTEND_PORT=8080
BACKEND_PORT=3001
MAILPIT_WEB_PORT=8025
