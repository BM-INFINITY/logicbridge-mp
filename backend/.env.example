# ─── Server & Runtime ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Set TRUST_PROXY=1 when deployed behind reverse proxy (AWS ALB, Cloudflare, Nginx)
TRUST_PROXY=0
# Comma-separated list of allowed frontend origins for CORS validation
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
# Graceful shutdown wait timeout before killing active operations (in milliseconds)
SHUTDOWN_TIMEOUT_MS=15000

# ─── Database & Connection Pooling ───────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/logicbridge
# Maximum and minimum connection pool size for Mongoose
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
# Socket inactivity and server selection timeout in milliseconds
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# ─── Authentication & JWT Lifecycle ──────────────────────────────────────────
# Secret used to sign and verify JWT access and refresh tokens (min 32 characters)
JWT_SECRET=your_jwt_secret_here_min_32_characters_long
# Access token expiration (e.g. 15m, 1h)
JWT_ACCESS_EXPIRATION=15m
# Refresh token validity window in days
JWT_REFRESH_EXPIRATION_DAYS=7

# ─── Rate Limiting & Account Lockout ─────────────────────────────────────────
# Login attempt window and maximum failed attempts per IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
# Registration rate limit window and maximum registrations per IP
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT_MAX_ATTEMPTS=5
# Account lockout threshold and duration
AUTH_MAX_ACCOUNT_FAILED_ATTEMPTS=5
AUTH_ACCOUNT_LOCK_WINDOW_MS=900000
AUTH_LOCKOUT_DURATION_MS=1800000

# ─── Credentials & Secret Encryption ─────────────────────────────────────────
# AES-256-GCM encryption key used to encrypt connection credentials at rest (min 32 chars)
# CRITICAL: NEVER commit or change in production without running the key rotation procedure!
CREDENTIAL_ENCRYPTION_KEY=your_random_32_char_key_here
# HMAC secret used to sign and verify OAuth state tokens
OAUTH_STATE_SECRET=your_oauth_state_signing_secret_here

# ─── Worker Identity & Leasing ───────────────────────────────────────────────
# Unique ID identifying this node in a distributed cluster (auto-generated if empty)
WORKER_ID=
# Inactivity threshold before an execution left in 'running' status is reclaimed (ms)
STALE_EXECUTION_THRESHOLD_MS=300000
# Lock duration for webhook event claims before being eligible for recovery (ms)
WEBHOOK_CLAIM_TIMEOUT_MS=120000

# ─── Data Retention & Lifecycle ──────────────────────────────────────────────
# Number of days to retain security audit logs before automatic TTL purge
AUDIT_LOG_RETENTION_DAYS=90
# Days to retain terminal workflow executions before background pruning
EXECUTION_RETENTION_DAYS=90
# Days to retain webhook event payloads before pruning (Tier 1: idempotency stub is retained)
WEBHOOK_EVENT_RETENTION_DAYS=30
# Days to retain webhook deduplication stubs before purge (Tier 2: must be >= 90d to prevent replay, or 0 to keep forever)
WEBHOOK_DEDUPLICATION_RETENTION_DAYS=180
# Max items deleted per batch during retention cleanup to avoid database lock contention
DATA_CLEANUP_BATCH_SIZE=500
# Retention worker background interval in milliseconds (default 24h)
DATA_CLEANUP_INTERVAL_MS=86400000

# ─── Workflow Execution Resource Backpressure ────────────────────────────────
# Maximum number of iterations permitted per Loop node
MAX_LOOP_ITERATIONS=2000
# Maximum size in bytes of a single node step output (default: 5MB)
MAX_STEP_OUTPUT_SIZE_BYTES=5242880
# Maximum workflow execution run duration in milliseconds (default: 5 minutes)
MAX_EXECUTION_DURATION_MS=300000

# ─── Local Storage & Uploads ─────────────────────────────────────────────────
# Directory path for local file storage node (must be inside designated data dir)
LOGICBRIDGE_STORAGE_PATH=./data/storage
# Maximum uploaded file size in bytes (default: 10MB)
MAX_FILE_SIZE_BYTES=10485760

# ─── External Integrations ───────────────────────────────────────────────────

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback

# Frontend URL (Used for OAuth redirect callbacks)
FRONTEND_URL=http://localhost:5173

# AI Providers
GEMINI_API_KEY=
# Security flags for SSRF protection:
# Set to 'true' only if workflows need to reach internal LLMs (e.g. Ollama, LocalAI)
ALLOW_PRIVATE_AI_ENDPOINTS=false
ALLOWED_PRIVATE_AI_HOSTS=
ALLOW_OLLAMA_LOCAL=false

# SMTP Email Delivery (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="LogicBridge <noreply@logicbridge.io>"
